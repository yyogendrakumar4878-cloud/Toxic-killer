name: Build Capacitor Android APK

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v4

    - name: Set up Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '18'

    - name: Set up JDK 17
      uses: actions/setup-java@v5
      with:
        java-version: '17'
        distribution: 'temurin'

    - name: Install dependencies & Build Web App
      working-directory: ./toxic-killer-android
      run: |
        npm install
        npm run build

    - name: Initialize Capacitor Android & Sync
      working-directory: ./toxic-killer-android
      run: |
        npx cap init --web-dir dist --name "Toxic Killer" --bundle-id com.toxickiller.app || true
        npx cap add android || true
        npx cap sync android

    - name: Grant execute permission for gradlew
      run: chmod +x gradlew
      working-directory: ./toxic-killer-android/android

    - name: Build with Gradle (Debug APK)
      run: ./gradlew assembleDebug
      working-directory: ./toxic-killer-android/android

    - name: Upload APK
      uses: actions/upload-artifact@v4
      with:
        name: app-debug
        path: ./toxic-killer-android/android/app/build/outputs/apk/debug/app-debug.apk

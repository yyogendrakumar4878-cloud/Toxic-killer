
name: Build TOXIC KILLER Android APK

on:
  workflow_dispatch:
  push:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Extract project ZIP
        run: |
          unzip -q TOXIC_KILLER_Android_Starter.zip -d extracted
          PROJECT_DIR="$(dirname "$(find extracted -name package.json -print -quit)")"
          if [ "$PROJECT_DIR" = "extracted" ] || [ ! -f "$PROJECT_DIR/package.json" ]; then
            echo "Project package.json not found"
            exit 1
          fi
          echo "PROJECT_DIR=$PROJECT_DIR" >> $GITHUB_ENV

      - name: Install dependencies
        run: |
          cd "$PROJECT_DIR"
          npm install
          CAP_VERSION=$(node -p "require('./node_modules/@capacitor/core/package.json').version")
          npm install "@capacitor/android@$CAP_VERSION"

      - name: Build Android APK
        run: |
          cd "$PROJECT_DIR"
          npm run build
          if [ ! -d android ]; then
            npx cap add android
          fi
          npx cap sync android
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: TOXIC-KILLER-APK
          path: ${{ env.PROJECT_DIR }}/android/app/build/outputs/apk/debug/app-debug.apk
